# Application Settings
APP_NAME="Sports Betting Consensus System"
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./sports_betting.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Scraping Configuration
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.0
RATE_LIMIT_DELAY=2.0

# Claude API (optional, for LLM-based extraction)
CLAUDE_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24

# Sources
ENABLED_SOURCES=espn,bleacher_report

